# 실제 값은 이 파일에 넣지 않고 Supabase Project Secrets에 등록합니다.
# TOSS_API_BASE_URL=
# TOSS_MTLS_CERT=
# TOSS_MTLS_PRIVATE_KEY=
# 선택 사항: mTLS 프록시/연결 준비 전에는 비워두며, 설정 시 회원 생성 전에 검증합니다.
# TOSS_USER_VERIFICATION_URL=
# 임시 개발 단계는 false, mTLS 연결 후 운영 배포 전에는 반드시 true로 바꿉니다.
# TOSS_USER_VERIFICATION_REQUIRED=false
# SESSION_PEPPER=
# SESSION_TTL_SECONDS=3600
